<Window x:Class="EriiPet.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绘梨衣的便签"
        Width="360" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="Manual"
        KeyDown="OnKeyDown"
        Closing="OnClosing">

    <!-- 主容器 -->
    <Border Background="#FAF7F4" CornerRadius="16" BorderBrush="#E07856" BorderThickness="2"
            Padding="20" Margin="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#2D2A26"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <!-- 绘梨衣小头像 -->
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="#FFF3E0" BorderBrush="#E07856" BorderThickness="1"
                        Margin="0,0,10,0">
                    <TextBlock Text="🦊" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="绘梨衣的便签" FontSize="15" FontWeight="Bold"
                               Foreground="#2D2A26"/>
                    <TextBlock x:Name="DueTimeLabel" Text="现在"
                               FontSize="11" Foreground="#8A8278"/>
                </StackPanel>
            </StackPanel>

            <!-- 提醒内容 -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10"
                    BorderBrush="#EBE3D9" BorderThickness="1"
                    Padding="14,12" Margin="0,0,0,14">
                <TextBlock x:Name="ContentText"
                           Text="该喝水了"
                           FontSize="16" Foreground="#2D2A26"
                           TextWrapping="Wrap"
                           FontFamily="Microsoft YaHei"/>
            </Border>

            <!-- 确认按钮 -->
            <Button Grid.Row="2"
                    x:Name="ConfirmBtn"
                    Content="嗯，知道了"
                    Height="40"
                    FontSize="14" FontWeight="SemiBold"
                    Foreground="White"
                    Background="#E07856"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnConfirm"
                    IsDefault="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
