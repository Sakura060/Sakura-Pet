<Window x:Class="EriiPet.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎" Width="440" Height="720"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#FFFAFB" CornerRadius="20" BorderBrush="#F0D5DC" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.15" Color="#E07856"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- 标题 -->
            <StackPanel Margin="0,10,0,16" HorizontalAlignment="Center">
                <TextBlock Text="🌸" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="绘梨衣桌宠 Pro" FontSize="22" FontWeight="Bold"
                           Foreground="#E07856" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="—— 世界很温柔 ——" FontSize="12"
                           Foreground="#C0A0A0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 步骤 -->
            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                    BorderBrush="#F5E8EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="1️⃣ 配置 AI 聊天（灵魂）" FontWeight="Bold" Foreground="#E07856" FontSize="13"/>
                    <TextBlock Text="右键绘梨衣 → 设置 → AI 聊天，填入 API 地址和 Key" FontSize="12"
                               Foreground="#6A5A5C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="推荐 DeepSeek（deepseek-v4-flash），便宜好用" FontSize="11"
                               Foreground="#A09090" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                    BorderBrush="#F5E8EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="2️⃣ 右键菜单 — 一切从这里开始" FontWeight="Bold" Foreground="#E07856" FontSize="13"/>
                    <TextBlock Text="💬 聊天 · 📋 提醒 · 🍬 投喂 · 🍅 专注陪伴 · 🎧 倾听她 · ⚙️ 设置" FontSize="12"
                               Foreground="#6A5A5C" Margin="0,4,0,0"/>
                    <TextBlock Text="双击托盘图标也可以快速隐藏/显示" FontSize="11"
                               Foreground="#A09090" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                    BorderBrush="#F5E8EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="3️⃣ 跟她互动吧" FontWeight="Bold" Foreground="#E07856" FontSize="13"/>
                    <TextBlock Text="👆 单击惊讶 · 双击开心（偶尔「正义的铁拳！」）· 三击害羞" FontSize="12" Foreground="#6A5A5C"/>
                    <TextBlock Text="🤚 点她的头 = 摸摸头 · 鼠标靠近她会偷笑" FontSize="12" Foreground="#6A5A5C"/>
                    <TextBlock Text="✊ 拖拽 = 牵着她走（她最喜欢了！但甩她会生气）" FontSize="12" Foreground="#6A5A5C"/>
                    <TextBlock Text="🐤 小黄鸭会跑出来 → 点击玩石头剪刀布" FontSize="12" Foreground="#6A5A5C"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                    BorderBrush="#F5E8EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="4️⃣ 小秘密" FontWeight="Bold" Foreground="#E07856" FontSize="13"/>
                    <TextBlock Text="📝 她说的话会写在便签本上 · 🎀 设置里换皮肤" FontSize="12" Foreground="#6A5A5C"/>
                    <TextBlock Text="🎂 7月11日是她的生日；设置里填上你的，她也会记得" FontSize="12" Foreground="#6A5A5C"/>
                    <TextBlock Text="🌧️ 下雨画面会飘雨滴，深夜她也会想哥哥的歌" FontSize="12" Foreground="#6A5A5C"/>
                    <TextBlock Text="💾 数据备份 · 🖥️ 多显示器 · 🎧 想让她用游戏音色说话？"
                               FontSize="12" Foreground="#6A5A5C"/>
                    <TextBlock Text="    见「语音链路」文件夹的训练教程（进阶玩法）" FontSize="11" Foreground="#A09090"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="DontShowAgain" Content="不再显示此引导" Margin="0,6,0,4"
                      Foreground="#8A7A7C" FontSize="12"/>

            <!-- 确认按钮区 -->
            <Border Background="#FFF8F5" CornerRadius="14" Padding="18,14"
                    BorderBrush="#E07856" BorderThickness="2" Margin="0,8,0,0">
                <StackPanel>
                    <Button Content="我知晓啦！" Click="OnStart"
                            Background="#E07856" Foreground="White" FontSize="16" FontWeight="Bold"
                            Height="48" BorderThickness="0" Cursor="Hand" IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="（后面不会弹出）" FontSize="11" Foreground="#C0A0A0"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
